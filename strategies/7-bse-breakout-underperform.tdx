{策略7-北交所突破跑输}
A1:=MA(CLOSE,30)<MA(CLOSE,50) OR MA(CLOSE,120)<MA(CLOSE,250);
A2:=MA(CLOSE,60)>REF(MA(CLOSE,60),1) OR MA(CLOSE,20)<MA(CLOSE,50);
A3:=MA(CLOSE,30)>REF(MA(CLOSE,30),1) OR MA(CLOSE,30)<MA(CLOSE,50);
A4:=MA(CLOSE,60)>REF(MA(CLOSE,60),1) OR MA(CLOSE,30)<MA(CLOSE,50);
A5:=MA(CLOSE,250)>REF(MA(CLOSE,250),1) OR MA(CLOSE,50)<MA(CLOSE,120);
A6:=MA(CLOSE,20)>REF(MA(CLOSE,20),1) AND MA(CLOSE,120)<MA(CLOSE,250)*1.14 AND CLOSE>=REF(HHV(HIGH,10),1) AND CLOSE>=MA(CLOSE,50) AND CLOSE>=MA(CLOSE,60) AND HIGH>MA(CLOSE,120)*0.96 AND AMO>REF(HHV(AMO,2),1) AND AMO<REF(HHV(AMO,2),1)*9 AND MA(AMO,10)<35000000 AND AMO<70000000;
A7:=NAMELIKE('ST')=0 AND NAMELIKE('*ST')=0 AND NAMELIKE('SST')=0 AND NAMELIKE('S*ST')=0 AND NAMELIKE('S ST')=0 AND CLOSE/REF(CLOSE,10)<INDEXC/REF(INDEXC,10) AND INDEXC/REF(INDEXC,1)>1;
A:=A1 AND A2 AND A3 AND A4 AND A5 AND A6 AND A7;
{交易条件}
买入条件:=A;
卖出条件:=CLOSE<=MA(CLOSE,20);
{交易系统}
BUY(买入条件,A);
SELL(卖出条件,CLOSE);

{策略5-趋势突破跑输}
A1:=MA(CLOSE,20)>MA(CLOSE,30) OR MA(CLOSE,120)<MA(CLOSE,250);
A2:=MA(CLOSE,20)>REF(MA(CLOSE,20),1) OR MA(CLOSE,20)>MA(CLOSE,50);
A3:=MA(CLOSE,120)>MA(CLOSE,250)*1.075 OR MA(CLOSE,120)<MA(CLOSE,250);
A4:=MA(CLOSE,60)>REF(MA(CLOSE,60),1) OR MA(CLOSE,20)<MA(CLOSE,60) OR MA(CLOSE,120)>MA(CLOSE,250);
A5:=MA(CLOSE,50)>REF(MA(CLOSE,50),1) OR MA(CLOSE,30)<REF(MA(CLOSE,30),1) OR MA(CLOSE,250)>REF(MA(CLOSE,250),1);
A6:=MA(CLOSE,120)<REF(MA(CLOSE,120),1) OR MA(CLOSE,250)<REF(MA(CLOSE,250),1) OR MA(CLOSE,120)>MA(CLOSE,250);
A7:=MA(CLOSE,120)>REF(MA(CLOSE,120),1) OR MA(CLOSE,250)<REF(MA(CLOSE,250),1);
A8:=MA(CLOSE,30)>MA(CLOSE,60)*0.95 AND MA(CLOSE,20)>MA(CLOSE,50)*0.95 AND MA(CLOSE,30)<MA(CLOSE,60)*1.04 AND MA(CLOSE,20)<MA(CLOSE,50)*1.04 AND MA(CLOSE,20)<MA(CLOSE,30)*1.03 AND MA(CLOSE,50)<MA(CLOSE,60)*1.015 AND LLV(LOW,10)*1.075<HIGH AND HIGH<LOW*1.075 AND HIGH<MA(CLOSE,120)*1.1;
A9:=CLOSE>=REF(HHV(HIGH,10),1) AND CLOSE>=MA(CLOSE,50) AND CLOSE/REF(CLOSE,1)<1.065 AND FINANCE(1)<4000000000  AND AMO>REF(HHV(AMO,2),1) AND AMO<REF(HHV(AMO,2),1)*2.5 AND AMO<200000000;
A10:=MA(AMO,10)<60000000 OR AMO>110000000;
A11:=NAMELIKE('ST')=0 AND NAMELIKE('*ST')=0 AND NAMELIKE('SST')=0 AND NAMELIKE('S*ST')=0 AND NAMELIKE('S ST')=0 AND "399006$C"/REF("399006$C",10)>1 AND CLOSE/REF(CLOSE,10)<"399006$C"/REF("399006$C",10) AND CLOSE/REF(CLOSE,10)<INDEXC/REF(INDEXC,10) AND INDEXC/REF(INDEXC,1)>1;
A12:="999999$C"/REF("999999$C",10)>1 OR "399001$C"/REF("399001$C",10)>1;
A:=A1 AND A2 AND A3 AND A4 AND A5 AND A6 AND A7 AND A8 AND A9 AND A10 AND A11 AND A12;
{交易条件}
买入条件:=A;
卖出条件:=CLOSE<=MA(CLOSE,20);
{交易系统}
BUY(买入条件,A);
SELL(卖出条件,CLOSE);

{策略1-震荡突破跑赢}
A1:=MA(CLOSE,20)>MA(CLOSE,30) OR MA(CLOSE,30)<MA(CLOSE,60);
A2:=MA(CLOSE,20)>MA(CLOSE,120) OR MA(CLOSE,50)<MA(CLOSE,120);
A3:=MA(CLOSE,20)<MA(CLOSE,120) OR MA(CLOSE,60)>MA(CLOSE,120);
A4:=MA(CLOSE,20)<REF(MA(CLOSE,20),1) OR MA(CLOSE,20)>MA(CLOSE,30);
A5:=MA(CLOSE,250)<REF(MA(CLOSE,250),1) OR MA(CLOSE,50)>MA(CLOSE,60);
A6:=MA(CLOSE,50)>REF(MA(CLOSE,50),1) OR MA(CLOSE,30)<REF(MA(CLOSE,30),1);
A7:=MA(CLOSE,120)>REF(MA(CLOSE,120),1) OR MA(CLOSE,250)<REF(MA(CLOSE,250),1);
A8:=MA(CLOSE,120)>MA(CLOSE,250)*1.075 AND MA(CLOSE,120)<MA(CLOSE,250)*1.35 AND MA(CLOSE,50)>MA(CLOSE,120)*0.985 AND MA(CLOSE,50)<MA(CLOSE,120)*1.2 AND MA(CLOSE,60)*0.955<MA(CLOSE,30) AND MA(CLOSE,30)<MA(CLOSE,60)*1.04 AND MA(CLOSE,20)<MA(CLOSE,50)*1.05 AND MA(CLOSE,20)<MA(CLOSE,30)*1.04 AND MA(CLOSE,50)<MA(CLOSE,60)*1.02;
A9:=CLOSE>=REF(HHV(HIGH,10),1) AND CLOSE>=MA(CLOSE,50) AND CLOSE/REF(CLOSE,1)<1.06 AND LLV(LOW,10)*1.075<HIGH AND MA(CLOSE,120)*1.05<HIGH AND HIGH<LLV(LOW,2)*1.075 AND HIGH<LOW*1.065 AND LLV(LOW,2)>=MA(CLOSE,20) AND LOW<=REF(HHV(HIGH,1),1) AND FINANCE(1)<4000000000 AND AMO>REF(HHV(AMO,2),1) AND AMO<REF(HHV(AMO,2),1)*2.3 AND AMO>200000000;
A10:=NAMELIKE('ST')=0 AND NAMELIKE('*ST')=0 AND NAMELIKE('SST')=0 AND NAMELIKE('S*ST')=0 AND NAMELIKE('S ST')=0 AND "399006$C"/REF("399006$C",10)>1 AND INDEXC/REF(INDEXC,1)>1;
A:=A1 AND A2 AND A3 AND A4 AND A5 AND A6 AND A7 AND A8 AND A9 AND A10;
{交易条件}
买入条件:=A;
卖出条件:=CLOSE<=MA(CLOSE,20);
{交易系统}
BUY(买入条件,A);
SELL(卖出条件,CLOSE);

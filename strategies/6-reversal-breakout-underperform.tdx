{策略6-反转突破跑输}
A1:=MA(CLOSE,30)<MA(CLOSE,50) OR MA(CLOSE,120)<MA(CLOSE,250);
A2:=MA(CLOSE,30)>REF(MA(CLOSE,30),1) OR MA(CLOSE,20)<MA(CLOSE,30);
A3:=MA(CLOSE,60)>REF(MA(CLOSE,60),1) OR MA(CLOSE,20)<MA(CLOSE,50);
A4:=MA(CLOSE,60)>REF(MA(CLOSE,60),1) OR MA(CLOSE,50)<MA(CLOSE,60);
A5:=MA(CLOSE,50)>REF(MA(CLOSE,50),1) OR MA(CLOSE,120)<MA(CLOSE,250);
A6:=MA(CLOSE,30)>REF(MA(CLOSE,30),1) OR MA(CLOSE,60)>REF(MA(CLOSE,60),1);
A7:=MA(CLOSE,50)>REF(MA(CLOSE,50),1) OR MA(CLOSE,30)<REF(MA(CLOSE,30),1);
A8:=MA(CLOSE,120)>REF(MA(CLOSE,120),1) OR MA(CLOSE,250)<REF(MA(CLOSE,250),1);
A9:=CLOSE>=REF(HHV(HIGH,20),1) OR MA(CLOSE,30)>REF(MA(CLOSE,30),1);
A10:=LLV(LOW,2)<=MA(CLOSE,60) OR MA(CLOSE,120)<MA(CLOSE,250);
A11:=MA(CLOSE,30)<MA(CLOSE,60) AND MA(CLOSE,30)>MA(CLOSE,60)*0.95 AND MA(CLOSE,20)>MA(CLOSE,50)*0.945 AND MA(CLOSE,120)<MA(CLOSE,250)*1.075 AND LLV(LOW,10)*1.05<HIGH AND HIGH<LOW*1.075 AND LLV(LOW,3)<=MA(CLOSE,60);
A12:=CLOSE>=REF(HHV(HIGH,10),1) AND CLOSE>=MA(CLOSE,50) AND CLOSE>=MA(CLOSE,60) AND CLOSE/REF(CLOSE,1)<1.065 AND AMO>REF(HHV(AMO,2),1) AND AMO<REF(HHV(AMO,2),1)*3 AND AMO<200000000;
A13:=MA(AMO,10)<60000000 OR AMO>110000000;
A14:=NAMELIKE('ST')=0 AND NAMELIKE('*ST')=0 AND NAMELIKE('SST')=0 AND NAMELIKE('S*ST')=0 AND NAMELIKE('S ST')=0 AND "399006$C"/REF("399006$C",10)>1 AND CLOSE/REF(CLOSE,10)<"399006$C"/REF("399006$C",10) AND CLOSE/REF(CLOSE,10)<INDEXC/REF(INDEXC,10);
A15:="999999$C"/REF("999999$C",10)>1 OR "399001$C"/REF("399001$C",10)>1;
A:=A1 AND A2 AND A3 AND A4 AND A5 AND A6 AND A7 AND A8 AND A9 AND A10 AND A11 AND A12 AND A13 AND A14 AND A15;
{交易条件}
买入条件:=A;
卖出条件:=CLOSE<=MA(CLOSE,20);
{交易系统}
BUY(买入条件,A);
SELL(卖出条件,CLOSE);
